            key: "MEM.SLOW_RAM",
            runtime: false,
            options: [
                { name: "None", value: 0 },
                { name: "512 KB", value: 512 },
                { name: "1 MB", value: 1024 },
                { name: "1.5 MB", value: 1536 }
