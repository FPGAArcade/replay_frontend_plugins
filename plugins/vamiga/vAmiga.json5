// vAmiga - Cycle-accurate Amiga 500/1000/2000 emulator core
// Configuration based on vAmiga's Swift UI settings
name: "vAmiga",
plugin: "vamiga.so",
launch_helper: "amiga",  // Platform-specific boot file detection (launch_helpers/amiga/)

metadata: {
    shortname: "vAmiga",
    fullname: "Commodore Amiga (vAmiga)",
    manufacturer: "Commodore",
    year: "1985",
    info: "vAmiga is a cycle-exact Amiga 500, 1000, and 2000 emulator created by Dirk W. Hoffmann. It accurately emulates the original Amiga custom chipset (OCS/ECS) including Agnus, Denise, and Paula.",
    tags: ["Computer", "Amiga", "Commodore", "Motorola", "68000", "OCS", "ECS"],
    icon: ""
},

extensions: ["adf", "adz", "dms", "hdf", "hdz", "img", "ima"],

bios: {
    directory: "amiga",
    files: [
        {
            name: "kick13.rom",
            description: "Kickstart 1.3 ROM (A500, Rev 34.5)",
            size: 262144,
            sha256: "e40a5dfb3d017ba8779faba30cbd1c8e19f0ad2e6a8be3fc9f780be7a7e74b73",
            required: true,
            note: "Standard A500 ROM, required for most games"
        },
        {
            name: "kick12.rom",
            description: "Kickstart 1.2 ROM (A500, Rev 33.180)",
            size: 262144,
            sha256: "891e9a547772fe0c6c19b610baf8bc4ea7fcb785057f26995067ce59e8502b03",
            required: false,
            note: "Early A500 ROM, needed for some older software"
        },
        {
            name: "kick204.rom",
            description: "Kickstart 2.04 ROM (A500+)",
            size: 524288,
            sha256: "c5839f5cb98a7a8947065c3ed2f14f5f42e334a1e10cd8f0e9c78e2e5a50c511",
            required: false,
            note: "Required for A500+ emulation"
        },
        {
            name: "kick31.rom",
            description: "Kickstart 3.1 ROM (A1200/A4000)",
            size: 524288,
            sha256: "e21545723fe8374e91342617604f1b3d703094f1a1e0c5b8939bd0ca80d71fae",
            required: false,
            note: "Required for AGA chipset emulation"
        }
    ]
},

// Floppy and hard drive configuration
drives: {
    floppy: [
        { id: "df0", name: "DF0", description: "Internal floppy drive", connected: true, extensions: ["adf", "adz", "dms", "img", "ima"] },
        { id: "df1", name: "DF1", description: "External floppy drive 1", connected: false, extensions: ["adf", "adz", "dms", "img", "ima"] },
        { id: "df2", name: "DF2", description: "External floppy drive 2", connected: false, extensions: ["adf", "adz", "dms", "img", "ima"] },
        { id: "df3", name: "DF3", description: "External floppy drive 3", connected: false, extensions: ["adf", "adz", "dms", "img", "ima"] }
    ],
    hard: [
        { id: "hd0", name: "HD0", description: "Hard drive 0", connected: false, extensions: ["hdf", "hdz"] },
        { id: "hd1", name: "HD1", description: "Hard drive 1", connected: false, extensions: ["hdf", "hdz"] },
        { id: "hd2", name: "HD2", description: "Hard drive 2", connected: false, extensions: ["hdf", "hdz"] },
        { id: "hd3", name: "HD3", description: "Hard drive 3", connected: false, extensions: ["hdf", "hdz"] }
    ]
},

// OSD Actions
actions: [
    { id: "soft_reset", name: "Soft Reset", description: "Reset the Amiga (Ctrl+Amiga+Amiga)", menu: "System" },
    { id: "hard_reset", name: "Hard Reset", description: "Power cycle the Amiga", menu: "System" },
    { id: "save_state", name: "Save State", description: "Save current emulator state", menu: "State" },
    { id: "load_state", name: "Load State", description: "Load previously saved state", menu: "State" }
],

// Amiga model presets
presets: [
    {
        id: "a500",
        name: "Amiga 500",
        description: "Standard A500 configuration",
        settings: {
            "AGNUS.REVISION": 2,
            "DENISE.REVISION": 0,
            "RTC.MODEL": 0,
            "MEM.BANKMAP": 0
        }
    },
    {
        id: "a1000",
        name: "Amiga 1000",
        description: "Original A1000 configuration",
        settings: {
            "AGNUS.REVISION": 0,
            "DENISE.REVISION": 0,
            "RTC.MODEL": 0,
            "MEM.BANKMAP": 1
        }
    },
    {
        id: "a2000",
        name: "Amiga 2000",
        description: "A2000 configuration",
        settings: {
            "AGNUS.REVISION": 3,
            "DENISE.REVISION": 0,
            "RTC.MODEL": 1,
            "MEM.BANKMAP": 2
        }
    },
    {
        id: "a500plus",
        name: "Amiga 500+",
        description: "A500+ with ECS chipset",
        settings: {
            "AGNUS.REVISION": 3,
            "DENISE.REVISION": 1,
            "RTC.MODEL": 1,
            "MEM.BANKMAP": 0
        }
    }
],

// Core configuration options
// runtime: true  = can be changed while emulator is running (shown in OSD)
// runtime: false = requires reset to take effect (shown in settings before launch)
config: {
    default: 0,

    options: [
        //
        // HARDWARE - Chipset (runtime: false - require reset)
        //
        {
            name: "Video Standard",
            key: "AMIGA.VIDEO_FORMAT",
            runtime: false,
            options: [
                { name: "PAL", value: 0 },
                { name: "NTSC", value: 1 }
            ],
            menu: "Hardware"
        },
        {
            name: "CPU Revision",
            key: "CPU.REVISION",
            runtime: false,
            options: [
                { name: "68000", value: 0, note: "Original Amigas" },
                { name: "68010", value: 1 },
                { name: "68EC020", value: 2, note: "A1200, A2500" }
            ],
            menu: "Hardware"
        },
        {
            name: "CPU Speed",
            key: "CPU.OVERCLOCKING",
            runtime: true,
            options: [
                { name: "1x (7 MHz)", value: 1 },
                { name: "2x (14 MHz)", value: 2 },
                { name: "4x (28 MHz)", value: 4 },
                { name: "8x (56 MHz)", value: 8 }
            ],
            menu: "Hardware"
        },
        {
            name: "Agnus Revision",
            key: "AGNUS.REVISION",
            runtime: false,
            options: [
                { name: "OCS (8367/8361)", value: 0, note: "A1000, A2000A" },
                { name: "OCS (8371/8370)", value: 1, note: "Early A500, A2000" },
                { name: "ECS 1MB (8372A)", value: 2, note: "Later A500, A2000" },
                { name: "ECS 2MB (8375)", value: 3, note: "A500+, A600" }
            ],
            menu: "Hardware"
        },
        {
            name: "Denise Revision",
            key: "DENISE.REVISION",
            runtime: false,
            options: [
                { name: "OCS (8362R8)", value: 0, note: "A500, A1000, A2000" },
                { name: "ECS (8373R4)", value: 1, note: "A500+, A600" }
            ],
            menu: "Hardware"
        },
        {
            name: "CIA Revision",
            key: "CIA.REVISION",
            runtime: false,
            options: [
                { name: "8520 DIP", value: 0, note: "A500, A1000, A2000, A500+" },
                { name: "8520 PLCC", value: 1, note: "A600" }
