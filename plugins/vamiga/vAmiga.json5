            menu: "Hardware"
        },
        {
            name: "Real-Time Clock",
            key: "RTC.MODEL",
            runtime: false,
            options: [
                { name: "None", value: 0 },
                { name: "OKI (MSM6242B)", value: 1, note: "A2000, A500+" },
                { name: "Ricoh (RF5C01A)", value: 2, note: "A3000, A4000" }
            ],
            menu: "Hardware"
