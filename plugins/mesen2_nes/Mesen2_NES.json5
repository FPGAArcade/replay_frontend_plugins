// Mesen2 NES - Cycle-accurate NES/Famicom emulator core
name: "Mesen2_NES",
plugin: "mesen2_nes.so",

metadata: {
    shortname: "Mesen2",
    fullname: "Nintendo Entertainment System (Mesen2)",
    manufacturer: "Nintendo",
    year: "1983",
    info: "Mesen2 is a highly accurate NES/Famicom emulator by Sour. It supports all licensed games and most unlicensed games with cycle-perfect emulation.",
    tags: ["Console", "NES", "Famicom", "Nintendo", "8-bit", "2A03"],
    icon: ""
},

extensions: ["nes", "fds", "unf", "unif", "nsf", "nsfe"],

bios: {
    directory: "nes",
    files: [
        {
            name: "disksys.rom",
            description: "Famicom Disk System BIOS",
            size: 8192,
            sha256: "99c18490ed9002d9c6d999b9d8d15be5c051bdfa7cc7e73318053c9a994b0178",
            required: false,
            note: "Required only for FDS games"
        }
    ]
},

// OSD Actions
actions: [
    { id: "soft_reset", name: "Reset", description: "Reset the NES", menu: "System" },
    { id: "hard_reset", name: "Power Cycle", description: "Power cycle the NES", menu: "System" },
    { id: "save_state", name: "Save State", description: "Save current emulator state", menu: "State" },
    { id: "load_state", name: "Load State", description: "Load previously saved state", menu: "State" }
],

// Configuration options
config: {
    default: 0,
    options: [
        // Video settings
        {
            name: "Region",
            key: "REGION",
            type: "enum",
            values: [
                { id: 0, name: "Auto" },
                { id: 1, name: "NTSC" },
                { id: 2, name: "PAL" },
                { id: 3, name: "Dendy" }
            ],
            default: 0,
            runtime: true,
            menu: "Video"
        },
        {
            name: "Hide Overscan",
            key: "OVERSCAN",
            type: "bool",
            default: true,
            runtime: true,
            menu: "Video"
        },
        // Audio settings
        {
            name: "Stereo Panning",
            key: "STEREO_PANNING",
            type: "bool",
            default: false,
            runtime: true,
            menu: "Audio"
        }
    ]
}
